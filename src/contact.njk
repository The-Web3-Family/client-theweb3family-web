---
layout: base.njk
title: Contact | The Web3 Family
description: Call, text, email, or schedule a call with Christopher Clarke directly.
---
<!-- CONTACT -->
<section>
  <div class="wrap">
    <h1>Let&rsquo;s talk.</h1>
    <p class="subhead">Pick whatever is easiest. Every message comes straight to me.</p>

    <div class="contact-grid">
      <div class="contact-ways">
        <a class="way way-primary" href="https://calendly.com/aweb3dad/15-minute-greeting" onclick="Calendly.initPopupWidget({url:'https://calendly.com/aweb3dad/15-minute-greeting'});return false;">
          <span class="way-label">Schedule your call today</span>
          <span class="way-detail">A free 15 minute call on my calendar</span>
          <span class="way-go" aria-hidden="true">&rarr;</span>
        </a>
        <a class="way" href="tel:+13107036003">
          <span class="way-label">Call or text</span>
          <span class="way-detail">(310) 703-6003</span>
          <span class="way-go" aria-hidden="true">&rarr;</span>
        </a>
        <a class="way" href="mailto:christopher@theweb3family.com">
          <span class="way-label">Email</span>
          <span class="way-detail">christopher@theweb3family.com</span>
          <span class="way-go" aria-hidden="true">&rarr;</span>
        </a>
        <p class="contact-place">Based in Inglewood, California. Working with nonprofits everywhere.</p>
      </div>

      <form class="contact-form contact-card" id="contact-form">
        <h2 class="contact-card-title">Send a note</h2>
        <input type="hidden" name="access_key" value="ef40ba3c1449496fb32d9c93756e1575">
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none">
        <label>Name
          <input type="text" name="name" autocomplete="name" required>
        </label>
        <label>Email
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label><span>Organization <span class="optional">(optional)</span></span>
          <input type="text" name="organization" autocomplete="organization">
        </label>
        <label>How can I help?
          <textarea name="message" rows="5" required></textarea>
        </label>
        <div class="form-status" role="status" aria-live="polite"></div>
        <button type="submit" class="cta"><span>Send</span></button>
      </form>
    </div>
  </div>
</section>

<script src="https://splitforms.com/embed.js" async></script>
<script>
(function(){
  var form = document.getElementById('contact-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = form.querySelector('[type=submit]');
    var label = btn.querySelector('span');
    var status = form.querySelector('.form-status');
    btn.disabled = true;
    label.textContent = 'Sending…';
    status.textContent = '';
    fetch('https://splitforms.com/api/submit', {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: new FormData(form)
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        form.reset();
        status.textContent = 'Sent. I’ll be in touch soon.';
      } else {
        status.textContent = data.message || 'Something went wrong. Please try again.';
      }
      btn.disabled = false;
      label.textContent = 'Send';
    })
    .catch(function() {
      status.textContent = 'Couldn’t send. Please try again.';
      btn.disabled = false;
      label.textContent = 'Send';
    });
  });
})();
</script>
