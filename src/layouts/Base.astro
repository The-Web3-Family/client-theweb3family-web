---
/*
  THE WEB3 FAMILY  ·  theweb3family.com
  Built with Astro. This is the one shared layout: the <head>, the header,
  and the footer. Page content lives in each page's own file under
  src/pages/. Read CLAUDE.md before changing anything.

  The design system lives in one place, src/styles.css, and every page
  shares it through this layout. Keep page-specific styles there too,
  scoped with a class.

  Header navigation: four links (Portfolio, About, Articles, Contact) and
  the booking button. Below 760px it is a <details>/<summary> disclosure,
  so it opens with zero JavaScript; at 760px and up it is a plain inline
  nav. Both exist in the markup at once, one hidden by CSS. Adding a link
  needs an explicit conversation with Christopher first.

  Analytics: Microsoft Clarity, Google Analytics, Vercel Speed Insights,
  and PostHog (its own project, "The Web3 Family") load on every page,
  each on Christopher's direct request. The PostHog token is a public
  project key, safe in page code. PostHog waits for the privacy banner at
  the bottom of this file: see the consent note there.
  Calendly's popup assets load on every page too, since the footer's
  booking button appears everywhere.

  The newsletter form in the footer is a plain HTML POST to
  /api/subscribe (api/subscribe.js at the repo root), which keeps the
  Buttondown key on the server. The hidden "company" field is a honeypot.
*/
import '../styles.css';
import CallButton from '../components/CallButton.astro';

interface Props {
  title: string;
  description: string;
  robotsMeta?: string;
  noindex?: boolean;
  ogType?: string;
  image?: string;
  imageAlt?: string;
}
const { title, description, robotsMeta, noindex = false, ogType = 'website', image = '/brand/og-default.png', imageAlt } = Astro.props;

const pathname = Astro.url.pathname.startsWith('/404') ? '/404.html' : Astro.url.pathname;
const pageUrl = `https://theweb3family.com${pathname}`;
const isHome = pathname === '/';

// Organization + Person JSON-LD, homepage only. Inert structured data for
// search engines, with the same @id values the About page uses.
const organization = `{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://theweb3family.com/#organization",
  "name": "The Web3 Family",
  "alternateName": "The Web3 Family, Creative Studio for Nonprofits",
  "description": "A one-person creative studio for nonprofits in Inglewood, California that builds websites, brand identity, pitch decks, apps, donation platforms, and fundraising infrastructure for nonprofits.",
  "disambiguatingDescription": "The Web3 Family is a nonprofit-focused design and build studio. It is not a cryptocurrency, blockchain, or Web3 software company.",
  "url": "https://theweb3family.com",
  "email": "christopher@theweb3family.com",
  "telephone": "+1-310-703-6003",
  "logo": "https://theweb3family.com/brand/png/W3F_logo_icon_fullcolor_2x.png",
  "image": "https://theweb3family.com/christopher.jpg",
  "priceRange": "$500 - $3,000",
  "founder": { "@id": "https://theweb3family.com/#christopher" },
  "areaServed": "United States",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Inglewood",
    "addressRegion": "CA",
    "addressCountry": "US"
  },
  "sameAs": ["https://www.youtube.com/@theweb3family"],
  "knowsAbout": ["nonprofit website design", "brand identity", "pitch decks", "donation platforms", "mobile apps", "fundraising strategy"]
}`;
const person = `{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://theweb3family.com/#christopher",
  "name": "Christopher Clarke",
  "jobTitle": "Founder",
  "worksFor": { "@id": "https://theweb3family.com/#organization" },
  "sameAs": ["https://www.linkedin.com/in/aweb3dad"],
  "email": "christopher@theweb3family.com",
  "telephone": "+1-310-703-6003",
  "url": "https://theweb3family.com/about/"
}`;
