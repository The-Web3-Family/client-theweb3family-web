  // A visitor who accepted on an earlier page starts recording right away.
  var w3fChoice = null;
  try { w3fChoice = localStorage.getItem('w3f_consent'); } catch (e) {}
  posthog.init('phc_xYaKi2YW3BTDk3Dst9hpxUCQw5NQArci7ppCKDWFyYX6', {
