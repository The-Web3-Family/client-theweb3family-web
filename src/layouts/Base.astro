<!--
  PRIVACY CHOICES BANNER. Added Nov 19 2026 on Christopher's direct brief.
  Governs PostHog only (see the posthog.init note in <head>). Shown at the
  bottom of the screen until the visitor picks Accept or Decline; the
  footer's "Privacy choices" button brings it back. Both buttons carry the
  same size and weight on purpose: an equal choice. Hidden by default, so
  with JavaScript off it stays out of the way, and PostHog stays quiet too.
-->
<div class="consent-bar" id="consent-bar" role="region" aria-label="Privacy choices" hidden>
  <div class="wrap consent-row">
    <p class="consent-text">We use privacy-friendly analytics and anonymous session recordings to improve this site. <a href="/privacy/">Privacy policy</a></p>
    <div class="consent-actions">
      <button type="button" class="consent-btn" data-consent="accepted">Accept</button>
      <button type="button" class="consent-btn" data-consent="declined">Decline</button>
    </div>
  </div>
</div>
<script is:inline>
(function () {
  var KEY = 'w3f_consent';
  var bar = document.getElementById('consent-bar');
  var root = document.documentElement;
  var memory = null;
  var returnFocus = null;

  function read() {
    try { return localStorage.getItem(KEY) || memory; } catch (e) { return memory; }
  }
  function save(choice) {
    memory = choice;
    try { localStorage.setItem(KEY, choice); } catch (e) {}
  }

  // Hands the saved choice to PostHog, once its script has loaded.
  function apply() {
    var ph = window.posthog;
    if (!ph || !ph.__loaded) return;
    var choice = read();
    // PostHog's own record of an explicit choice: 'granted', 'denied', or
    // 'pending'. (A visitor who hasn't chosen also reads as "opted out"
    // to has_opted_out_capturing, so that check can't tell the two apart.)
    var status = ph.get_explicit_consent_status();
    if (choice === 'accepted') {
      if (status !== 'granted') ph.opt_in_capturing();
      ph.startSessionRecording();
    } else if (choice === 'declined') {
      if (ph.sessionRecordingStarted && ph.sessionRecordingStarted()) ph.stopSessionRecording();
      if (status !== 'denied') ph.opt_out_capturing();
    }
  }
  window.w3fApplyConsent = apply;

  // While the bar shows, the page gains matching space at its very end, so
  // the footer stays reachable. Nothing above it moves.
  function fit() { root.style.setProperty('--consent-h', bar.offsetHeight + 'px'); }
  function show() { bar.hidden = false; root.classList.add('consent-open'); fit(); }
  function hide() { bar.hidden = true; root.classList.remove('consent-open'); }

  var current = read();
  if (current !== 'accepted' && current !== 'declined') show();
  window.addEventListener('resize', function () { if (!bar.hidden) fit(); });

  bar.addEventListener('click', function (event) {
    var button = event.target.closest('[data-consent]');
    if (!button) return;
    save(button.getAttribute('data-consent'));
    hide();
    apply();
    if (returnFocus) { returnFocus.focus(); returnFocus = null; }
  });

  var link = document.querySelector('[data-consent-link]');
  if (link) {
    link.hidden = false;
    link.querySelector('button').addEventListener('click', function () {
      returnFocus = this;
      show();
      bar.querySelector('[data-consent]').focus();
    });
  }

  apply();
})();
</script>

