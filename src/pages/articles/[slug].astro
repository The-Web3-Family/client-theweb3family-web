---
/*
  ARTICLE PAGE. One page per Markdown file in src/content/articles/.
  Top to bottom, in the order a reader on a phone meets it:
    breadcrumb -> date line (date, minutes to read, "Updated" when the
    article carries an `updated` date) -> title -> "The short answer"
    box (`summary`) -> cover image with caption (`image`, `imageAlt`,
    optional `imageCaption`) -> the article -> author note -> a plain
    link to The Friday Letter signup in the footer -> the one booking
    button -> up to three more articles.
  Every optional piece simply disappears when its front matter field is
  left out. The JSON-LD blocks are inert structured data for search
  engines: the article itself, its breadcrumb, and, when the front matter
  carries `faq`, a FAQPage block that repeats the questions on the page.
*/
import { existsSync } from 'node:fs';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CallButton from '../../components/CallButton.astro';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, more: articles.filter((other) => other.id !== article.id).slice(0, 3) },
  }));
}

const { article, more } = Astro.props;
const { title, description, date, updated, summary, image, imageAlt, imageCaption, keyword } = article.data;
const { titleTag, category, schemaType, shareImage, faq } = article.data;

// A share image is used for link previews only, and only once its file is
// really in public/. Until then the preview falls back to the cover image
// or the site's standard share card.
const shareImageReady = shareImage && existsSync(`${process.cwd()}/public${shareImage}`);
const previewImage = (shareImageReady ? shareImage : image) ?? undefined;
const { Content } = await render(article);

const readableDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// Minutes to read, at a gentle 200 words a minute.
const words = (article.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));
const pageUrl = `https://theweb3family.com/articles/${article.id}/`;

// "<" is escaped so text inside the data can never close the script tag.
const ld = (data: unknown) => JSON.stringify(data, null, 2).replace(/</g, '\\u003c');
const blogPosting = ld({
  '@context': 'https://schema.org',
  '@type': schemaType ?? 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  mainEntityOfPage: pageUrl,
  image: `https://theweb3family.com${previewImage ?? '/brand/og-default.png'}`,
  ...(category ? { articleSection: category } : {}),
  author: {
    '@type': 'Person',
    '@id': 'https://theweb3family.com/#christopher',
    name: 'Christopher Clarke',
    jobTitle: 'Founder, The Web3 Family, Creative Studio for Nonprofits',
    image: 'https://theweb3family.com/christopher.jpg',
    url: 'https://theweb3family.com',
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://theweb3family.com/#organization',
    name: 'The Web3 Family',
    logo: { '@type': 'ImageObject', url: 'https://theweb3family.com/brand/png/W3F_logo_icon_fullcolor_2x.png' },
  },
  isPartOf: { '@type': 'Blog', name: 'The Friday Letter', url: 'https://theweb3family.com/articles/' },
  ...(keyword ? { keywords: keyword } : {}),
});
const breadcrumbs = ld({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://theweb3family.com/' },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://theweb3family.com/articles/' },
    { '@type': 'ListItem', position: 3, name: title },
  ],
});
const faqPage = faq && faq.length > 0 && ld({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
});
---
<Base title={titleTag ?? title} description={description} ogType="article" image={previewImage} imageAlt={shareImageReady ? undefined : imageAlt ?? undefined}>
<script is:inline type="application/ld+json" set:html={blogPosting} />
<script is:inline type="application/ld+json" set:html={breadcrumbs} />
{faqPage && <script is:inline type="application/ld+json" set:html={faqPage} />}
<article class="prose article">
  <div class="wrap">
    <p class="breadcrumb"><a href="/">Home</a> &rarr; <a href="/articles/">Articles</a></p>
    <p class="article-date">
      <time datetime={date.toISOString()}>{readableDate(date)}</time>{' '}&middot; {readingTime} minute read
      {updated && <><br>Updated <time datetime={updated.toISOString()}>{readableDate(updated)}</time></>}
    </p>
    <h1>{title}</h1>

    {summary && (
      <div class="article-summary">
        <p class="article-summary-label">The short answer</p>
        <p>{summary}</p>
      </div>
    )}

    {image && (
      <figure class="article-cover">
        <img src={image} alt={imageAlt ?? ''} width="1200" height="630">
        {imageCaption && <figcaption>{imageCaption}</figcaption>}
      </figure>
    )}

    <Content />

    <div class="author-note">
      <img class="portrait portrait-sm" src="/christopher.jpg" alt="Christopher Clarke">
      <p>Hi, I&rsquo;m Christopher. I run The Web3 Family, a creative studio for nonprofits in Inglewood, California. Every Friday I share what I learn building for founders like you.</p>
    </div>

    <p class="article-letter">Want a new lesson every Friday? <a href="#newsletter-heading">Join The Friday Letter</a>, it&rsquo;s free.</p>

    <CallButton wrapClass="content-cta" />

    {more.length > 0 && (
      <>
        <h2 class="crosslinks-heading">More from The Friday Letter</h2>
        <ul class="case-crosslinks">
          {more.map((other) => <li><a href={`/articles/${other.id}/`}>{other.data.title}</a></li>)}
        </ul>
      </>
    )}
  </div>
</article>
</Base>
