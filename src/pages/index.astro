---
import Base from '../layouts/Base.astro';
import { trialLink, callLink } from '../site';

const title = "The Web3 Family | Websites and Donation Pages for LA Nonprofits";
const description = "Your nonprofit deserves an online presence worth funding. Websites, donation pages, decks, brand books, and videos for small Los Angeles nonprofits. Start with a 2-week free trial.";

const clientQuote = { text: '', name: '', role: '', org: '', googleReviewsUrl: '' };

const clients = [
  {
    slug: 'love-aid-foundation',
    key: 'love-aid',
    name: 'Love Aid Foundation',
    summary: 'A nonprofit driving impact through music and charity',
    site: 'loveaid.foundation',
    pkg: 'Family Package',
    result: '',
    person: '',
  },
  {
    slug: 'ask-g-pop',
    key: 'ask-g-pop',
    name: 'Ask G-Pop',
    summary: "A nonprofit investing into America's future",
    site: 'askgpop.online',
    pkg: 'Family Package',
    result: '',
    person: '',
  },
  {
    slug: 'rap-frogs',
    key: 'rap-frogs',
    name: 'Rap Frogs',
    summary: 'An upcoming nonprofit spreading awareness to the youth about drugs and crime',
    site: 'rapfrogs.online',
    pkg: 'Family Package',
    result: '',
    person: '',
  },
];

const faqs = [
  {
    q: 'How does the free trial work?',
    a: 'You get two full weeks of the Family Package. Your card is saved through Stripe, and billing starts on day 15. Cancel before then and you pay nothing.',
  },
  {
    q: 'Who owns the domain and the website?',
    a: "You do. Everything we make lives in your nonprofit's own accounts and Google Drive.",
  },
  { q: 'Can I edit the site myself?', a: '' },
  {
    q: 'How does cancelling work?',
    a: 'Month to month. Cancel anytime and keep everything we created.',
  },
  {
    q: 'What does the Web3 in Web3 Family mean?',
    a: 'Web3 describes this generation of the internet, where you own everything you create.',
    html: 'Web3 describes this generation of the internet, where <strong>you own everything you create.</strong>',
  },
  { q: 'What do you need from me?', a: 'Just your thoughts.' },
].filter((item) => item.a);

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}, null, 2).replace(/</g, '\\u003c');

const squiggle = 'M16 18 C26 16 36 16 45 16 C36 22 26 28 16 33 C26 32 36 31 45 31 C36 36 26 41 16 45 C26 44 36 43 45 43';
const weekdays = ['M', 'T', 'W', 'T'];
---
<Base title={title} description={description}>
<script is:inline type="application/ld+json" set:html={faqLd} />
<div class="hero hero-home">
  <div class="wrap">
    <div class="me">
      <img class="portrait" src="/christopher.jpg" alt="Christopher Clarke">
      <div>
        <b>Christopher Clarke</b>
        <span>Inglewood, California</span>
      </div>
    </div>

    <h1>Your nonprofit deserves an online presence worth funding.</h1>

    <p class="hero-sub">Websites, donation pages, decks, brand books, and videos for small Los Angeles nonprofits. A finished piece in your inbox every Friday.</p>

    <div class="actions">
      <a class="cta" {...trialLink}>
        <span>Start your 2-week free trial</span>
      </a>
      <p class="call-alt">or <a {...callLink}>book a free 15-minute call</a> &middot; <a href="tel:+13107036003">(310) 703-6003</a></p>
    </div>

    <ul class="reass">
      <li>Month to month</li>
      <li>Cancel anytime</li>
      <li>You own everything</li>
    </ul>
  </div>
</div>

{clientQuote.text && (
  <section class="band quote-band">
    <div class="wrap">
      <blockquote>
        <p>&ldquo;{clientQuote.text}&rdquo;</p>
        <cite>
          {[clientQuote.name, clientQuote.role, clientQuote.org].filter(Boolean).join(', ')}
          {clientQuote.googleReviewsUrl && (
            <> &middot; <a href={clientQuote.googleReviewsUrl} target="_blank" rel="noopener"><span class="quote-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 5.0 on Google</a></>
          )}
        </cite>
      </blockquote>
    </div>
  </section>
)}

<section class="section-ruled">
  <div class="wrap">
    <h2>Donors check your website before they give.</h2>
    <div class="info-cards">
      <div class="info-card">
        <h3>An outdated site loses trust</h3>
        <p>First impressions decide whether a donor, partner, or funder keeps reading.</p>
      </div>
      <div class="info-card">
        <h3>A hidden donate button loses gifts</h3>
        <p>Every extra click between caring and giving costs you support.</p>
      </div>
      <div class="info-card">
        <h3>Missing materials slow grants</h3>
        <p>Funders ask for decks, one-pagers, and a clear story. Have them ready.</p>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <h2>Everything your nonprofit needs to be found and funded.</h2>
    <div class="info-cards info-cards--four">
      <div class="info-card">
        <svg class="info-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect x="4" y="7" width="32" height="26" rx="2"/><path d="M4 15h32M9 11h.01M13 11h.01"/></svg>
        <h3>Website</h3>
        <p>Fast, mobile-ready, built to bring in support.</p>
      </div>
      <div class="info-card">
        <svg class="info-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M20 33S6 24.5 6 15a7.5 7.5 0 0 1 14-3.7A7.5 7.5 0 0 1 34 15c0 9.500-14 18-14 18z"/></svg>
        <h3>Donation page</h3>
        <p>Simple giving that keeps more of every gift.</p>
      </div>
      <div class="info-card">
        <svg class="info-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect x="5" y="6" width="30" height="21" rx="2"/><path d="M11 13h18M11 19h11M20 27v7M13 34h14"/></svg>
        <h3>Deck and brand book</h3>
        <p>Materials funders and partners take seriously.</p>
      </div>
      <div class="info-card">
        <svg class="info-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect x="4" y="8" width="32" height="24" rx="2"/><path d="M17 15l8 5-8 5z"/></svg>
        <h3>Videos</h3>
        <p>Your story, ready for social and your site.</p>
      </div>
    </div>
    <p class="section-note">Everything is saved to your nonprofit's own Google Drive.</p>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <h2>Nonprofits we've worked with</h2>
    <div class="cards">
      {clients.map((client) => (
        <div class={`card card--${client.key}`}>
          <span class="card-watermark" aria-hidden="true"></span>
          <span class="eyebrow-person"><span class="org-name">{client.name}</span></span>
          {client.result && <p class="card-result">{client.result}</p>}
          <h3>{client.summary}</h3>
          <p class="card-meta">{client.person && <>{client.person} &middot; </>}{client.pkg}</p>
          <a class="card-btn card-btn--link" href={`/case-studies/${client.slug}/`} aria-label={`See the full story of the ${client.name} build`}>See the full story <span aria-hidden="true">&rarr;</span></a>
          <div class="card-site"><a href={`https://${client.site}`} target="_blank" rel="noopener">{client.site}</a><span class="link-out-icon" aria-hidden="true">&#8599;</span></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>How it works</h2>
    <ol class="steps">
      <li>
        <span class="step-num" aria-hidden="true">1</span>
        <h3>Start your free trial</h3>
        <p>Two weeks, on us. Tell us what your nonprofit needs.</p>
      </li>
      <li>
        <span class="step-num" aria-hidden="true">2</span>
        <h3>Your first piece arrives Friday</h3>
        <p>A finished website section, page, deck, or video in your inbox.</p>
      </li>
      <li>
        <span class="step-num" aria-hidden="true">3</span>
        <h3>Keep going month to month</h3>
        <p>Stay as long as it's working for you. Cancel anytime.</p>
      </li>
    </ol>
  </div>
</section>

<section id="booking" class="ink ink-watermark">
  <div class="wrap">
    <h2>Available Packages</h2>

    <div class="price-cards">
      <article class="price-card p1">
        <h3>Trial</h3>
        <p class="price-card-desc">Try the full Family experience</p>
        <p class="price-figure">
          <span class="sr-only">Free for 2 weeks</span>
          <span aria-hidden="true" class="fig-lining">Free</span>
          <span aria-hidden="true" class="price-per">for 2 weeks</span>
        </p>
        <div class="price-tiles" aria-hidden="true">
          {weekdays.map((day) => <span class="price-tile"><b>{day}</b></span>)}
          <span class="price-tile lit"><b>F</b></span>
        </div>
        <ul class="price-features">
          <li>A finished piece every Friday</li>
          <li>Websites, donation pages, decks, brand books, and videos</li>
          <li>Everything saved to your Google Drive</li>
        </ul>
        <a class="price-card-cta is-trial" {...trialLink}>Start free trial</a>
        <p class="price-fine">Card on file through Stripe. Cancel before day 14 and pay nothing.</p>
      </article>

      <article class="price-card rec p1">
        <span class="price-badge">Most popular</span>
        <h3>Family Package</h3>
        <p class="price-card-desc">Text and call anytime</p>
        <p class="price-figure">
          <span class="sr-only">495 dollars per month</span>
          <span aria-hidden="true" class="fig-lining">$495</span>
          <span aria-hidden="true" class="price-per">/ month</span>
        </p>
        <div class="price-tiles" aria-hidden="true">
          {weekdays.map((day) => <span class="price-tile"><b>{day}</b></span>)}
          <span class="price-tile lit"><b>F</b></span>
        </div>
        <ul class="price-features">
          <li>A finished piece every Friday</li>
          <li>Websites, donation pages, decks, brand books, and videos</li>
          <li>Everything saved to your Google Drive</li>
          <li>Month to month, cancel anytime</li>
        </ul>
        <a class="price-card-cta is-trial" {...trialLink}>Start with a free trial<span class="sr-only"> of the Family Package</span></a>
      </article>

      <article class="price-card p2">
        <h3>Family Package + Coaching</h3>
        <p class="price-card-desc">Dedicated one-on-one time</p>
        <p class="price-figure">
          <span class="sr-only">1,495 dollars per month</span>
          <span aria-hidden="true" class="fig-lining">$1,495</span>
          <span aria-hidden="true" class="price-per">/ month</span>
        </p>
        <div class="price-tiles" aria-hidden="true">
          {weekdays.map((day, i) => (
            <span class={`price-tile t${i}`}><svg class="price-sq" viewBox="0 0 60 60" focusable="false"><path d={squiggle}/></svg><b>{day}</b></span>
          ))}
          <span class="price-tile lit"><b>F</b></span>
        </div>
        <ul class="price-features">
          <li>Everything in the Family Package</li>
          <li>Dedicated one-on-one time with Christopher</li>
          <li>Strategy for growth, funding, and visibility</li>
        </ul>
        <a class="price-card-cta" {...callLink}>Book a free 15-minute call<span class="sr-only"> about Family Package + Coaching</span></a>
      </article>
    </div>

    <div class="price-more">
      <div>
        <h3>Need more one-on-one time?</h3>
        <p>Extra coaching hours are available on any package.</p>
      </div>
      <a class="btn-cream" {...callLink}>Let's talk</a>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>Have Questions?</h2>

    <div class="faq-list">
      {faqs.map((item) => (
        <div class="faq-item">
          <h3>{item.q}</h3>
          {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="band closing">
  <div class="wrap">
    <h2>Ready to be found and funded?</h2>
    <p class="closing-sub">Two weeks free. A finished piece every Friday.</p>
    <a class="cta" {...trialLink}>
      <span>Start your 2-week free trial</span>
    </a>
    <p class="call-alt">or call or text <a href="tel:+13107036003">(310) 703-6003</a> &middot; <a href="mailto:christopher@theweb3family.com?subject=Booking%20a%20call">email directly</a></p>
  </div>
</section>
</Base>
