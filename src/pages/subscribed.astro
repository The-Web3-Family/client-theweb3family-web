---
import Base from '../layouts/Base.astro';

const title = "One more step | The Web3 Family";
const description = "Check your email to confirm your newsletter signup.";
---
<Base title={title} description={description} noindex>
<section>
  <div class="wrap">
    <h1>One more step: check your email.</h1>
    <p class="subhead">I just sent a message from The Web3 Family. Open it and tap Confirm subscription, and you’re on the list.</p>
    <p>It usually arrives within a minute. If you don’t see it, check your Promotions or Spam folder and mark it as safe.</p>
    <p>While you wait, see how <a href="/case-studies/love-aid-foundation/">Love Aid Foundation got its weekly system</a>.</p>
    <a class="newsletter-btn" href="/" style="background:var(--cream-deep)">Back to the homepage</a>
  </div>
</section>
</Base>
